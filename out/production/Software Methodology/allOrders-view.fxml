<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.AllOrdersController">
   <bottom>
      <HBox alignment="CENTER" prefHeight="75.0" prefWidth="600.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnExportAllOrdersToFile" mnemonicParsing="false" onAction="#handleExportAllOrdersToFile" text="Export All Orders to File" />
            <Button fx:id="btnMainMenu" mnemonicParsing="false" onAction="#handleMainMenu" text="Main Menu" />
         </children>
      </HBox>
   </bottom>
   <top>
      <StackPane prefHeight="80.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="80.0" fitWidth="601.0" pickOnBounds="true">
               <image>
                  <Image url="@images/banner-background.png" />
               </image>
            </ImageView>
            <Label text="All Orders">
               <font>
                  <Font name="Georgia Bold" size="45.0" />
               </font>
            </Label>
         </children>
      </StackPane>
   </top>
   <center>
      <TextArea fx:id="txtAllOrders" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
