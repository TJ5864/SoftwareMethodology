<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Pizza image on the left -->
    <ImageView
        android:id="@+id/imagePizza"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:contentDescription="@string/desc_pizza_image"
        android:scaleType="centerCrop" />

    <!-- Name and toppings stacked on the right -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Pizza name e.g. "NY Deluxe" -->
        <TextView
            android:id="@+id/textPizzaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Toppings e.g. "Sausage, Pepperoni, Green Pepper..." -->
        <TextView
            android:id="@+id/textToppings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#666666"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
